# Copy to .env and fill in your values

# Option A: Full connection string (takes precedence, used on Render/Neon)
# DATABASE_URL=postgresql://user:password@host:5432/jobqueue?sslmode=require

# Option B: Individual values (used for local development)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=jobqueue

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
